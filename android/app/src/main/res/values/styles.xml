<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rezzerv" parent="Theme.AppCompat.NoActionBar" />

    <!-- Açılış etkinliği yalnızca Chrome'u başlatıp kapanıyor. Arka planı
         markanın rengi olmalı; varsayılan beyaz kalsaydı koyu temalı işletme
         uygulamasında göz alıcı bir beyaz parlama olurdu. -->
    <style name="Theme.Rezzerv.Launcher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
    </style>
</resources>
