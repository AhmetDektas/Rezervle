# --- Veritabanı ---------------------------------------------------------
# Yerel geliştirme: SQLite (kurulum gerektirmez).
# Üretim: PostgreSQL'e geçmek için prisma/schema.prisma içindeki provider'ı
# "postgresql" yapıp DATABASE_URL'i postgres bağlantı dizesiyle değiştirin.
DATABASE_URL="file:./dev.db"
# Postgres (docker compose up -d sonrasi, T1 gocuyle birlikte):
# DATABASE_URL="postgresql://rezzerv:rezzerv@localhost:5432/rezzerv?schema=public"

# --- Oturum -------------------------------------------------------------
# En az 32 karakter. Üretimde MUTLAKA değiştirin:  openssl rand -base64 48
AUTH_SECRET="degistirin-bu-yalnizca-gelistirme-icin-32-karakterden-uzun-bir-anahtar"

# --- Uygulama -----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# "development" iken demo giriş kısayolları ve tohum hesapları açıktır.
NODE_ENV="development"

# --- Sağlayıcılar (opsiyonel) -------------------------------------------
# Boş bırakılırsa konsola yazan geliştirme adaptörleri kullanılır.
EMAIL_PROVIDER="console"      # console | smtp
SMS_PROVIDER="console"        # console | netgsm
PAYMENT_PROVIDER="mock"       # mock | iyzico

# --- Kapora ana salteri ---------------------------------------------------
# Platform capinda kapora tahsilatini aninda durdurur. Varsayilan ACIK:
# degisken tanimsizsa kapora calisir. Kapatmak acik bir eylem olmali, cunku
# ters kurgu bir dagitimda degisken unutuldugunda geliri sessizce durdururdu.
# false yapildiginda rezervasyon alinmaya devam eder, odeme isletmede yapilir.
# DEPOSITS_ENABLED="false"
# SMTP_URL="smtp://kullanici:parola@smtp.example.com:587"
# NETGSM_USER=""
# NETGSM_PASSWORD=""
# IYZICO_API_KEY=""
# IYZICO_SECRET_KEY=""

# --- Kuyruk (arka plan işleri) -------------------------------------------
# Hatırlatma, ödeme süre aşımı ve bildirim yeniden denemesi bu kuyruktan
# geçer. Worker ayrı bir süreç olarak çalışır: `npm run worker`.
REDIS_URL="redis://localhost:6379"
# Zarif kapanış üst sınırı. Barındırma platformunun SIGKILL süresinden kısa
# tutun ki kapanış kontrollü bitsin.
WORKER_SHUTDOWN_TIMEOUT_MS="25000"
