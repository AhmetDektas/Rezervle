{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // tests/e2e BURADA DEĞİL, bilerek: eskiden dışlanıyordu ve E2E spec'leri
  // hiç tip denetiminden geçmiyordu. Uygulamada bir alan yeniden
  // adlandırıldığında spec ancak 17 dakikalık koşunun ortasında, çalışma
  // anında patlıyordu. Şimdi `tsc --noEmit` saniyeler içinde söylüyor.
  "exclude": ["node_modules", "legacy"]
}
